# ── MTG Card Scanner configuration ─────────────────────────────────────────
# Copy this file to `.env` (gitignored) and edit. The systemd service loads it
# via EnvironmentFile, and the Python layer reads it via scripts/env_config.py,
# so Node and Python share one source of truth.

# ── HTTP / HTTPS ───────────────────────────────────────────────────────────
PORT=3000
HTTPS_PORT=3443
NODE_ENV=production

# ── Paths (relative to the repo root) ──────────────────────────────────────
UPLOAD_DIR=uploads
DATA_DIR=data
SCRYFALL_INDEX_PATH=data/scryfall-hash-index.json

# ── External MariaDB (shared by Node db.js and Python scripts) ─────────────
# The installer prompts for these on first run. Do NOT install MariaDB inside
# the LXC — point at your existing server.
DB_HOST=192.168.4.41
DB_PORT=3306
DB_NAME=mtg_inventory
DB_USER=mtgscanner
DB_PASSWORD=change-me

# ── Python interpreter (virtual environment) ───────────────────────────────
# The server spawns this interpreter for its Python subprocesses. install.sh
# creates .venv and sets this automatically.
PYTHON_INTERPRETER=/opt/mtg-card-scanner/.venv/bin/python

# ── CollectorVision model/catalog cache ────────────────────────────────────
# Where CollectorVision downloads Cornelius/Milo weights and the MTG embedding
# catalog. Must be writable by the mtgscanner service account.
COLLECTORVISION_CACHE=/opt/mtg-card-scanner/.collectorvision-cache

# ── Daily data refresh schedule (cron) ─────────────────────────────────────
# Cron expression in the container's local time. Default: 03:00 daily.
# The container timezone should be set to Australia/Sydney (see deploy/README).
REFRESH_SCHEDULE=0 3 * * *