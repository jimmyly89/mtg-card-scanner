# mtg-card-scanner.service — systemd unit for the MTG Card Scanner app.
#
# Installed to /etc/systemd/system/mtg-card-scanner.service by install.sh.
# Do not edit this file directly — it is managed by deploy/install.sh and
# deploy/update.sh. Local overrides belong in /etc/systemd/system/
# mtg-card-scanner.service.d/*.conf.
#
# The app listens on HTTP (PORT, default 3000) and HTTPS (HTTPS_PORT, default
# 3443).

[Unit]
Description=MTG Card Scanner (Express + Python OCR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated non-root account (created by install.sh).
User=mtgscanner
Group=mtgscanner

# Absolute path to the repository checkout.
WorkingDirectory=/opt/mtg-card-scanner

# Load secrets + configuration from the gitignored .env file (DB creds, ports,
# PYTHON_INTERPRETER, etc.).
EnvironmentFile=-/opt/mtg-card-scanner/.env

# Use the Python virtual environment for the app's Python subprocesses.
Environment=PYTHON_INTERPRETER=/opt/mtg-card-scanner/.venv/bin/python
Environment=PATH=/usr/local/bin:/usr/bin:/bin

ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Writable directories: data (SQLite, uploads, images, logs, refresh state),
# uploads, .certs (HTTPS certs), .collectorvision-cache (models/catalog).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mtg-card-scanner/data /opt/mtg-card-scanner/uploads /opt/mtg-card-scanner/.certs /opt/mtg-card-scanner/.collectorvision-cache

[Install]
WantedBy=multi-user.target
